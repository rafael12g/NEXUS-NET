<!DOCTYPE html>
<html lang="fr">
<head>
    <title>Paramètres — Nexus Net</title>
    <%- include('partials/head') %>
</head>
<body>
    <div class="container">
        <%- include('partials/navbar') %>

        <div class="auth-container">
            <h2 class="auth-title">Paramètres du compte</h2>

            <% if (error) { %>
                <div class="alert alert-error"><%= error %></div>
            <% } %>
            <% if (success) { %>
                <div class="alert alert-success"><%= success %></div>
            <% } %>
            <% if (forcePasswordChange) { %>
                <div class="alert alert-warning">Pour des raisons de sécurité, veuillez changer votre mot de passe.</div>
            <% } %>

            <form action="/settings/update" method="POST">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <div class="category-header" style="margin-bottom: 15px; color: var(--accent-blue);">Profil</div>
                <div class="form-group">
                    <label for="username">Nom d'utilisateur</label>
                    <input type="text" id="username" name="username" value="<%= profile.username %>" required
                           minlength="3" maxlength="30" pattern="[a-zA-Z0-9_.\-]{3,30}">
                </div>
                <div class="form-group">
                    <label for="email">Email</label>
                    <input type="email" id="email" name="email" value="<%= profile.email || '' %>">
                </div>
                <div class="category-header" style="margin: 20px 0 15px; color: var(--accent-blue);">Personnalisation</div>
                <div class="form-group">
                    <label for="themeColor">Couleur d'accent</label>
                    <input type="color" id="themeColor" name="themeColor" value="<%= profile.theme_color || '#38bdf8' %>" style="height: 45px; padding: 0;">
                </div>
                <button type="submit" class="btn btn-primary" style="width: 100%;">Mettre à jour le profil</button>
            </form>

            <form action="/settings/password" method="POST" style="margin-top: 30px;">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <div class="category-header" style="margin-bottom: 15px; color: var(--accent-purple);">Sécurité</div>
                <div class="form-group">
                    <label for="currentPassword">Mot de passe actuel</label>
                    <input type="password" id="currentPassword" name="currentPassword" required autocomplete="current-password">
                </div>
                <div class="form-group">
                    <label for="newPassword">Nouveau mot de passe (8 caractères min.)</label>
                    <input type="password" id="newPassword" name="newPassword" required minlength="8" autocomplete="new-password">
                </div>
                <button type="submit" class="btn btn-primary" style="width: 100%;">Changer le mot de passe</button>
            </form>

            <div style="margin-top: 40px; padding-top: 20px; border-top: 1px solid var(--border-color);">
                <div class="category-header" style="margin-bottom: 15px; color: var(--accent-red);">Zone danger</div>
                <form action="/settings/delete" method="POST"
                      data-confirm="Supprimer votre compte ? Cette action est irréversible et supprimera tous vos plans.">
                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                    <button type="submit" class="btn btn-danger" style="width: 100%;">Supprimer le compte</button>
                </form>
            </div>
        </div>
    </div>
</body>
</html>
