<!DOCTYPE html>
<html lang="fr">
<head>
    <title>Dashboard — Nexus Net</title>
    <%- include('partials/head') %>
</head>
<body>
    <div class="container">
        <%- include('partials/navbar') %>

        <div class="dashboard-header">
            <h2>Mes plans</h2>
            <form action="/plans/create" method="POST" style="margin: 0;">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <div style="display: flex; gap: 10px;">
                    <input type="text" name="name" placeholder="Nom du nouveau plan" required maxlength="100" style="width: 220px; margin-bottom: 0;">
                    <button type="submit" class="btn btn-primary btn-small"><i class="fas fa-plus"></i> Créer</button>
                </div>
            </form>
        </div>

        <div class="plans-grid">
            <% if (plans.length === 0) { %>
                <p style="color: var(--text-secondary);">Vous n'avez aucun plan pour le moment. Créez-en un ci-dessus pour commencer.</p>
            <% } else { %>
                <% plans.forEach(function(plan) { %>
                    <div class="plan-card">
                        <div>
                            <div class="plan-title"><%= plan.name %></div>
                            <div class="plan-date">
                                Modifié le <%= new Date(plan.updated_at || plan.created_at).toLocaleDateString('fr-FR') %>
                            </div>
                        </div>
                        <div style="display:flex; gap:8px; align-items:center;">
                            <a href="/editor/<%= plan.id %>" class="btn btn-primary btn-small"><i class="fas fa-pen-to-square"></i> Ouvrir</a>
                            <form action="/plans/<%= plan.id %>/delete" method="POST" style="margin:0;"
                                  data-confirm="Supprimer le plan « <%= plan.name %> » ? Cette action est irréversible.">
                                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                <button type="submit" class="btn btn-danger btn-small" title="Supprimer"><i class="fas fa-trash"></i></button>
                            </form>
                        </div>
                    </div>
                <% }); %>
            <% } %>
        </div>
    </div>
</body>
</html>
