<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Nexus Net — <%= plan.name %></title>

    <script src="https://unpkg.com/vis-network/standalone/umd/vis-network.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;800&family=JetBrains+Mono:wght@400;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/css/editor.css">
    <style>
        :root { --accent-blue: <%= (theme && theme.accent) ? theme.accent : '#38bdf8' %>; }
    </style>
</head>
<body data-plan-id="<%= plan.id %>" data-csrf="<%= csrfToken %>">

    <div id="dropZone">
        <i class="fas fa-file-import" style="font-size: 60px; color: var(--accent-blue); margin-bottom: 20px;"></i>
        <h1>Lâchez pour ouvrir</h1>
    </div>

    <div id="toast">Projet sauvegardé</div>

    <div id="sidebar">
        <a href="/dashboard" class="btn-ghost" style="text-decoration:none; display:flex; align-items:center; gap:5px; margin-bottom: 10px; padding: 8px; justify-content: center;">
            <i class="fas fa-arrow-left"></i> Retour Dashboard
        </a>

        <h2><i class="fas fa-globe" style="color:var(--accent-green)"></i> NEXUS NET</h2>
        <div style="font-size: 12px; color: var(--text-secondary); margin-bottom: 10px;"><%= plan.name %></div>

        <div style="background: rgba(255,255,255,0.05); padding: 8px; border-radius: 6px; display:flex; align-items:center; margin-bottom: 15px; border: 1px solid var(--border-color);">
            <i class="fas fa-search" style="color: #64748b; margin-right: 8px;"></i>
            <input type="text" id="searchNode" placeholder="Rechercher…" style="width: 100%; border:none; background:transparent; color:white; margin:0; padding:0;">
        </div>

        <div class="category-header">Outils de vue</div>
        <div class="item-grid" style="grid-template-columns: repeat(3, 1fr); margin-bottom: 15px;">
            <button class="item-btn" data-action="fit" title="Recentrer"><i class="fas fa-compress-arrows-alt"></i><span>Centrer</span></button>
            <button class="item-btn" data-action="toggle-grid" title="Grille"><i class="fas fa-border-all"></i><span>Grille</span></button>
            <button class="item-btn" data-action="toggle-link" id="btnLinkMode" title="Mode liaison"><i class="fas fa-bezier-curve"></i><span>Lier</span></button>
            <button class="item-btn" data-action="toggle-magnet" id="btnMagnet" title="Aimant"><i class="fas fa-magnet"></i><span>Aimant</span></button>
            <button class="item-btn" data-action="align-v" title="Aligner verticalement"><i class="fas fa-arrows-alt-v"></i><span>Align V</span></button>
            <button class="item-btn" data-action="align-h" title="Aligner horizontalement"><i class="fas fa-arrows-alt-h"></i><span>Align H</span></button>
        </div>

        <div class="section-header">Bibliothèque</div>

        <div style="margin-bottom: 15px;">
            <input type="text" id="nodeLabel" placeholder="Nom (optionnel)" style="margin-bottom:5px;">
            <input type="text" id="nodeIP" placeholder="IP (optionnel)">
            <div style="margin-top:5px;">
                <label style="margin:0; font-size:10px; color:var(--text-secondary);">Couleur</label>
                <div id="colorPalette" style="display:flex; gap:5px; flex-wrap:wrap; margin-top:5px;"></div>
                <input type="hidden" id="nodeColor" value="#38bdf8">
            </div>
        </div>

        <div class="category-header">Infrastructure</div>
        <div class="item-grid">
            <button class="item-btn" data-action="add-node" data-type="server"><i class="fas fa-server"></i><span>Serveur</span></button>
            <button class="item-btn" data-action="add-node" data-type="router"><i class="fas fa-network-wired"></i><span>Routeur</span></button>
            <button class="item-btn" data-action="add-node" data-type="switch"><i class="fas fa-microchip"></i><span>Switch</span></button>
            <button class="item-btn" data-action="add-node" data-type="firewall"><i class="fas fa-shield-halved"></i><span>Firewall</span></button>
            <button class="item-btn" data-action="add-node" data-type="cloud"><i class="fas fa-cloud"></i><span>Internet</span></button>
            <button class="item-btn" data-action="add-node" data-type="db"><i class="fas fa-database"></i><span>Data</span></button>
            <button class="item-btn" data-action="add-node" data-type="docker"><i class="fab fa-docker docker-icon"></i><span>Docker</span></button>
        </div>

        <div class="category-header">Utilisateurs</div>
        <div class="item-grid">
            <button class="item-btn" data-action="add-node" data-type="pc"><i class="fas fa-desktop"></i><span>PC</span></button>
            <button class="item-btn" data-action="add-node" data-type="printer"><i class="fas fa-print"></i><span>Print</span></button>
            <button class="item-btn" data-action="add-node" data-type="wifi"><i class="fas fa-wifi"></i><span>Wifi</span></button>
        </div>

        <div class="category-header">Outils</div>
        <div class="item-grid">
            <button class="item-btn" data-action="add-node" data-type="note"><i class="fas fa-sticky-note"></i><span>Note</span></button>
            <button class="item-btn" data-action="pick-image"><i class="fas fa-image"></i><span>Image</span></button>
        </div>
        <input type="file" id="customImg" accept="image/*" style="display:none;">

        <div class="section-header">Docker</div>
        <button class="btn-primary" data-action="docker-import" style="width:100%; justify-content:center; margin-bottom: 8px;">
            <i class="fab fa-docker"></i> Importer sélectif
        </button>
        <button class="btn-primary" data-action="docker-generate" style="width:100%; justify-content:center; background: var(--accent-green);">
            <i class="fas fa-project-diagram"></i> Générer schéma
        </button>

        <div class="section-header">
            Connexion
            <button class="btn-ghost" data-action="connect-selected" title="Lier la sélection" style="padding: 4px 8px; font-size:10px;">
                <i class="fas fa-bolt" style="color:var(--accent-orange)"></i>
            </button>
        </div>

        <div style="display:flex; gap:5px;">
            <select id="fromNode"><option>Src…</option></select>
            <select id="toNode"><option>Dst…</option></select>
        </div>
        <button class="btn-ghost" data-action="add-edge" style="width:100%; justify-content:center;">
            <i class="fas fa-link"></i> Connecter
        </button>

        <div class="section-header">Infos réseau</div>
        <div style="background: rgba(255,255,255,0.05); border-radius: 6px; padding: 8px; margin-bottom: 15px;">
            <div class="stat-item"><span class="stat-label">Nœuds</span><span class="stat-value" id="stat-nodes">0</span></div>
            <div class="stat-item"><span class="stat-label">Connexions</span><span class="stat-value" id="stat-edges">0</span></div>
            <div class="stat-item"><span class="stat-label">Docker running</span><span class="stat-value" id="stat-docker-running" style="color:#4ade80">0</span></div>
            <div class="stat-item"><span class="stat-label">Docker stopped</span><span class="stat-value" id="stat-docker-stopped" style="color:#f87171">0</span></div>
        </div>

        <div class="section-header">Légende active</div>
        <div id="legend-content" style="margin-bottom: 15px;"></div>

        <div class="section-header">Exports</div>
        <div style="display:grid; grid-template-columns: 1fr 1fr; gap:8px;">
            <button class="btn-ghost" data-action="save"><i class="fas fa-save"></i> Save</button>
            <button class="btn-ghost" data-action="open"><i class="fas fa-folder-open"></i> Ouvrir</button>
            <button class="btn-drawio" data-action="export-drawio" style="grid-column: span 2;">
                <i class="fas fa-shapes"></i> Export vers Draw.io
            </button>
            <button class="btn-ghost" data-action="export-json">JSON</button>
            <button class="btn-ghost" data-action="export-pdf">PDF</button>
        </div>

        <input type="file" id="fileLoader" accept=".json,application/json" style="display:none;">
    </div>

    <div id="workspace-wrapper">
        <div id="network-container" class="grid-bg"></div>
        <div id="selectionBox"></div>
        <div id="ruler-corner">px</div>
        <canvas id="ruler-top"></canvas>
        <canvas id="ruler-left"></canvas>
    </div>

    <div id="inspector">
        <div id="insp-content-node" style="display:none;">
            <div class="section-header" style="margin-top:0">Modifier l'appareil</div>

            <label>Nom</label>
            <input type="text" id="edit-name">
            <label>IP</label>
            <input type="text" id="edit-ip">
            <label>Couleur</label>
            <div id="editColorPalette" style="display:flex; gap:5px; flex-wrap:wrap; margin-bottom:10px;"></div>
            <input type="hidden" id="edit-color">
            <label>Opacité <span id="opacity-val" style="float:right">100%</span></label>
            <input type="range" id="edit-opacity" min="0" max="100" value="100">
            <label>Taille (px)</label>
            <input type="number" id="edit-size" min="10" max="300">

            <div id="docker-controls" style="display:none; margin-top:15px;">
                <div class="section-header" style="margin-top:0">Contrôles Docker</div>
                <div id="docker-status" style="padding:10px; background:rgba(0,0,0,0.3); border-radius:6px; margin-bottom:10px;">
                    <div style="display:flex; align-items:center; gap:8px;">
                        <span id="docker-status-indicator"></span>
                        <span id="docker-status-text" style="font-size:12px; color:var(--text-secondary);">Non connecté</span>
                    </div>
                </div>
                <div style="display:grid; grid-template-columns: 1fr 1fr 1fr; gap:5px;">
                    <button class="btn-ghost" data-action="docker-start" style="font-size:10px; padding:6px;"><i class="fas fa-play"></i></button>
                    <button class="btn-ghost" data-action="docker-stop" style="font-size:10px; padding:6px;"><i class="fas fa-stop"></i></button>
                    <button class="btn-ghost" data-action="docker-restart" style="font-size:10px; padding:6px;"><i class="fas fa-redo"></i></button>
                </div>
                <button class="btn-ghost" data-action="docker-refresh" style="width:100%; margin-top:5px; font-size:11px;">
                    <i class="fas fa-sync"></i> Rafraîchir
                </button>
            </div>
        </div>

        <div id="insp-content-edge" style="display:none;">
            <div class="section-header" style="margin-top:0">Modifier le câble</div>
            <label>Style</label>
            <select id="edit-edge-type">
                <option value="solid">Solide</option>
                <option value="dashed">Pointillés</option>
            </select>
            <label>Couleur</label>
            <input type="color" id="edit-edge-color" style="height:35px; padding:0;">
            <label>Épaisseur</label>
            <input type="range" id="edit-edge-width" min="1" max="10">
        </div>

        <div style="margin-top:20px; display:flex; gap:10px;">
            <button class="btn-danger" style="flex:1;" data-action="delete-selected"><i class="fas fa-trash"></i></button>
            <button class="btn-ghost" style="flex:1;" data-action="close-inspector">Fermer</button>
        </div>
    </div>

    <div id="minimap">
        <div id="minimap-header">Vue d'ensemble</div>
        <canvas id="minimap-canvas"></canvas>
    </div>

    <div id="nav-controls">
        <button data-action="zoom-in" title="Zoom avant"><i class="fas fa-plus"></i></button>
        <button data-action="zoom-out" title="Zoom arrière"><i class="fas fa-minus"></i></button>
        <button data-action="fit" title="Adapter à l'écran"><i class="fas fa-expand"></i></button>
    </div>

    <script id="plan-data-json" type="application/json"><%- plan.data ? JSON.stringify(plan.data) : 'null' %></script>
    <script src="/js/editor.js" defer></script>
</body>
</html>
